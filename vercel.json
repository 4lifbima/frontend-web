{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://alifbima.web.id/karya/api/:path*"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "https://alifbima.web.id/karya/sanctum/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://alifbima.web.id/karya/storage/:path*"
    },
    {
      "source": "/((?!api/|sanctum/|storage/).*)",
      "destination": "/index.html"
    }
  ]
}
